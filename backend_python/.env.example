# =============================================================
# KawalKontrak.ai — Backend Python Environment Variables
#
# Salin file ini menjadi `backend_python/.env` dan isi nilainya.
# JANGAN pernah commit file `.env` ke dalam git.
# =============================================================

# Kunci API Google Gemini (WAJIB) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Corpus regulasi (pilih SALAH SATU, File Search Store direkomendasikan) ──

# OPSI A (REKOMENDASI — persisten, managed RAG):
# Nama File Search Store, dihasilkan oleh: python scripts/upload_corpus.py
# Contoh: fileSearchStores/kawalkontrak-corpus-xxxx
GEMINI_FILE_SEARCH_STORE=

# OPSI B (fallback dev — PERINGATAN: file kedaluwarsa 48 JAM setelah upload):
# URI file PDF di Gemini File API, dihasilkan oleh:
#   python scripts/upload_corpus.py --mode file
GEMINI_CORPUS_FILE_URI=

# ── Keamanan ────────────────────────────────────────────────────────────────

# Secret bersama dengan proxy Next.js. Isi string acak yang sama dengan
# BACKEND_SHARED_SECRET di .env.local. Wajib untuk deployment publik.
BACKEND_SHARED_SECRET=

# ── Opsional ────────────────────────────────────────────────────────────────

# Override model per peran (default sudah sesuai TRD §3)
# KK_MODEL_LITE=gemini-2.5-flash-lite
# KK_MODEL_CORE=gemini-2.5-flash

# Port server FastAPI (default: 8000)
BACKEND_PORT=8000
