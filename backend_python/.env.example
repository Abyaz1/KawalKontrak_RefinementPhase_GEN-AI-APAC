# =============================================================
# KawalKontrak.ai — Backend Python Environment Variables
#
# File ini merupakan SALINAN dari variabel yang dibutuhkan.
# Salin file ini menjadi `.env` dan isi nilainya.
# JANGAN pernah commit file `.env` ke dalam git.
# =============================================================

# Kunci API Google Gemini (wajib diisi)
GEMINI_API_KEY=your_gemini_api_key_here

# URI file PDF Corpus UU Ketenagakerjaan yang sudah diupload ke Gemini File API
# Dihasilkan oleh script scripts/upload-corpus.ts
GEMINI_CORPUS_FILE_URI=https://generativelanguage.googleapis.com/v1beta/files/xaavv8m89jxs

# Port server FastAPI (default: 8000)
BACKEND_PORT=8000
