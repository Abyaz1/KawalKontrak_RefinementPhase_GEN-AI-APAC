# KawalKontrak.ai — Environment Variables (Next.js)
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# Konfigurasi backend AI ada di backend_python/.env.example (terpisah).

# URL backend Python FastAPI (default saat development)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Secret bersama dengan backend Python — WAJIB sama dengan
# BACKEND_SHARED_SECRET di backend_python/.env. Isi string acak panjang.
BACKEND_SHARED_SECRET=

# URL publik aplikasi (untuk metadata SEO). Opsional saat development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identitas penyelenggara yang tampil di halaman hukum (/disclaimer, /syarat,
# /privasi). Semuanya opsional; yang kosong tidak ditampilkan.
# Isi kedua alamat surel HANYA jika kotak masuknya benar-benar dipantau —
# dokumen hukum menjanjikan tanggapan ke alamat tersebut.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Firebase Config (untuk Autentikasi dan Firestore Database)
# Didapat dari Firebase Console -> Project Settings -> General -> Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
