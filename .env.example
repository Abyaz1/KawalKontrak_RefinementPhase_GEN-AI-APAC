# KawalKontrak.ai — Environment Variables
# Salin file ini menjadi `.env.local` lalu isi nilainya.

# Google Gemini API key — didapat dari https://aistudio.google.com/apikey
# Dipakai untuk: analisis kontrak (gemini-2.5-flash) dan RAG semantic
# search (gemini-embedding-001). Tanpa key ini aplikasi tetap berjalan
# menggunakan mesin deteksi pola lokal (tanpa AI).
GEMINI_API_KEY=

# URL publik aplikasi (untuk metadata SEO). Opsional saat development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
